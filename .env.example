# Modèle des variables d'environnement. Copie ce fichier en .env.local et remplis les valeurs.
# .env.local n'est jamais envoyé sur GitHub (voir .gitignore).

# Supabase, Project Settings > Data API : Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase, Project Settings > API Keys : Publishable key (commence par sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase, Project Settings > API Keys : Secret key (commence par sb_secret_)
# Sert seulement au script d'import, sur ce PC. Ne jamais la mettre dans Vercel.
SUPABASE_SECRET_KEY=

# Le seul compte autorisé dans l'admin
ADMIN_EMAIL=rolandanasse5@gmail.com
